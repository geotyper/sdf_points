#version 450
#extension GL_GOOGLE_include_directive : require
#include "braid_common.glsl"

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) writeonly buffer Samples {
    vec4 data[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    float u = TAU * float(i / 16u) / 64.0;
    float v = TAU * float(i % 16u) / 16.0;
    float strand = float((i / 16u) % 3u);
    vec3 center, tangent, x, y;
    float radius;
    tubeFrame(u, strand, center, tangent, x, y, radius);
    // The arched sphere stays out of surfacePoint: the braids' normals are taken
    // by differences of it and are sensitive to how it compiles.
    vec3 p = archMode() ? archGridPoint(u, v, strand) : surfacePoint(u, v, strand);
    vec3 offset = p - center;
    // Verify actual emitted positions, not merely the frame's nominal radius.
    float sectionError = max(abs(length(offset) - radius), abs(dot(offset, tangent)));
    data[i * 2u] = vec4(p, length(offset));
    data[i * 2u + 1u] = vec4(surfaceNormal(u, v, strand), sectionError);
}
